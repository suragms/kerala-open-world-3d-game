{
  "name": "kerala-open-world",
  "private": true,
  "version": "1.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "powershell -NoProfile -File scripts/browser-suite.ps1",
    "data:import": "python scripts/import_geography.py",
    "data:validate": "tsx scripts/validate-geography.ts && tsx scripts/audit-bus-routes.ts",
    "data:bus-tracks": "tsx scripts/prepare-bus-tracks.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0"
  }
}
